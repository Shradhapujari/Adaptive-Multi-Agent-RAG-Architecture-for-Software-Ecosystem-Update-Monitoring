venv311/
__pycache__/
*.pyc
.env
*.pdf
# ...except the paper's vector figures, which are SOURCE and not build output:
# they are generated by scripts/paper_figures.py from the run artifacts and are
# what \includegraphics pulls in. The blanket rule above (and paper/*.pdf below)
# is aimed at the compiled article.
!paper/Figures/*.pdf
evaluation_results.json
.DS_Store
*.log
node_modules/

# eval harness outputs (regenerable)
# `results/` with a `!results/qrels_cache.json` negation below does NOT work:
# git cannot re-include a file inside an excluded directory. Exclude the
# directory's *contents* instead, which negations can override.
results/*
# ...except the judgment cache: small, and it saves a fresh clone hours of
# re-judging. It is also part of the artifact (specs/reproducibility.md §2).
!results/qrels_cache.json
_derename.py
*.pyes
venv/

# frozen corpus recordings (large, regenerable from the live APIs)
data/corpus_snapshot*/

# LaTeX build products (regenerable with tectonic)
paper/*.aux
paper/*.log
paper/*.out
paper/*.xdv
paper/*.pdf
paper/*.blg
paper/*.bbl.bak

# local Claude Code session state (per-machine, not shared)
.claude/

# the ACM article template, downloaded from CTAN rather than vendored (16M)
acmart-primary-3/

# the local store (store.py): a document cache and a run log, both rebuilt by
# using the demo. Same reasoning as the corpus snapshots above -- fetched data,
# not source. The -wal/-shm siblings are sqlite's WAL journal.
data/*.db
data/*.db-wal
data/*.db-shm

# Presentation artifacts: regenerated per meeting, not needed to run the system
slides/
*.pptx
results/ui_feedback.jsonl
